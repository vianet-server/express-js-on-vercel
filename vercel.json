{
  "buildCommand": "cd vianet && npm ci && npm run build",
  "outputDirectory": "vianet/dist",
  "installCommand": "npm install",
  "functions": {
    "src/index.ts": {
      "includeFiles": "vianet/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/src/index.ts"
    }
  ]
}
